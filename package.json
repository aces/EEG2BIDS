{
  "name": "eeg2bids",
  "description": "EEG/iEEG to BIDS format Wizard",
  "version": "3.0.0-beta.1",
  "desktopName": "eeg2bids.desktop",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "papaparse": "^5.5.4",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.7",
    "react-switch": "^7.1.0",
    "react-tooltip": "6.0.8",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-react": "^7.37.5",
    "lint-staged": "17.0.8",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "scripts": {
    "dev": "concurrently -k --success first -n renderer,electron \"npm run dev:renderer\" \"setsid sh -c 'wait-on http://localhost:3000/ && npm run electron-start'\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "install:electron": "install-electron",
    "electron-start": "DEV=1 electron .",
    "start": "npm run dev",
    "lint": "eslint src electron",
    "test:unit": "vitest run",
    "test:electron": "npm run build && playwright test",
    "freeze:backend": "uv run --frozen --group packaging pyinstaller --noconfirm --distpath dist --workpath dist/.pyinstaller-work tools/eeg2bids-backend.spec",
    "dist:dir": "npm run build && npm run freeze:backend && electron-builder --linux dir",
    "dist:linux": "npm run build && npm run freeze:backend && electron-builder --linux deb",
    "dist:windows": "npm run build && npm run freeze:backend && electron-builder --win nsis --x64"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,json,css,md}": [
      "eslint --fix src",
      "git add"
    ]
  },
  "main": "electron/main/index.js",
  "homepage": "https://github.com/aces/eeg2bids",
  "build": {
    "appId": "ca.mcgill.mcin.eeg2bids",
    "productName": "EEG2BIDS",
    "executableName": "eeg2bids",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "public/logo512.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/eeg2bids-backend",
        "to": "backend"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Science",
      "icon": "public/logo512.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "EEG2BIDS-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "contributors": [
    "Alizée Wickenheiser",
    "Cécile Madjar",
    "Christine Rogers",
    "Derek Lo",
    "Laëtitia Fesselier"
  ],
  "author": {
    "name": "Loris Team",
    "email": "loris-dev@bic.mni.mcgill.ca",
    "url": "https://github.com/aces/eeg2bids"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
