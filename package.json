{
  "name": "eeg2bids",
  "description": "EEG/iEEG to BIDS format Wizard",
  "version": "3.0.0",
  "desktopName": "eeg2bids.desktop",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-switch": "^7.1.0",
    "react-tooltip": "6.0.10",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-react": "^7.37.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "scripts": {
    "dev": "concurrently -k --success first -n renderer,electron \"npm run dev:renderer\" \"wait-on http://localhost:3000/ && npm run electron-start\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "install:electron": "install-electron",
    "electron-start": "DEV=1 electron .",
    "start": "npm run dev",
    "lint": "eslint --ext .js,.jsx src electron",
    "test:unit": "vitest run",
    "test:electron": "npm run build && playwright test",
    "freeze:backend": "uv run --frozen --group packaging pyinstaller --noconfirm --distpath dist --workpath dist/.pyinstaller-work tools/eeg2bids-backend.spec",
    "dist:linux": "npm run build && npm run freeze:backend && electron-builder --linux deb --publish never",
    "dist:windows": "npm run build && npm run freeze:backend && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && npm run freeze:backend && electron-builder --mac dmg --arm64 --publish never"
  },
  "main": "electron/main/index.js",
  "homepage": "https://github.com/aces/eeg2bids",
  "build": {
    "appId": "ca.mcgill.mcin.eeg2bids",
    "productName": "EEG2BIDS",
    "executableName": "eeg2bids",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "public/logo512.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/eeg2bids-backend",
        "to": "backend"
      }
    ],
    "linux": {
      "category": "Science",
      "icon": "public/logo512.png",
      "syncDesktopName": true
    },
    "win": {
      "artifactName": "EEG2BIDS-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "public/logo512.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "EEG2BIDS-${version}-macos-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "contributors": [
    "Alizée Wickenheiser",
    "Cécile Madjar",
    "Christine Rogers",
    "Derek Lo",
    "Laëtitia Fesselier"
  ],
  "author": {
    "name": "Loris Team",
    "email": "loris-dev@bic.mni.mcgill.ca",
    "url": "https://github.com/aces/eeg2bids"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  }
}
